rules_version = '2';
// Chaque utilisateur connecté n'accède qu'à ses propres données.
// watch/{uid} : liste des tickers suivis (« Mes ETF »), lisible par le robot des cours
// (aucune donnée personnelle : identifiant anonyme + tickers + fréquence).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /watch/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.tickers is list
        && request.resource.data.tickers.size() <= 20
        && request.resource.data.freq in [1, 2];
    }
  }
}
